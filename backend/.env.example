NODE_ENV=development # production, development, test

APP_PORT=8081

# JWT
ACCESS_SECRET_KEY=hello_kitty
ACCESS_EXPIRES_IN=24h
REFRESH_EXPIRES_IN=30d  # random string of 30 days

FRONTEND_ORIGINS=fe_url_1,fe_url_2,fe_url_3
FRONTEND_URL=fe_url_1

AI_SERVICE_URL=ai_service_url


# Database configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hello_kitty
DB_PASSWORD=hello_kitty
DB_NAME=main_db
DB_URL=postgres://hello_kitty:hello_kitty@localhost:5432/main_db

# =============
# Observability
# =============
# Tracing configuration
SERVICE_NAME=backend-service
OTEL_EXPORTER_URL=http://localhost:4318

# Logging: stdout/stderr only; collector bên ngoài quyết định nơi lưu
LOG_FORMAT=json
LOG_LEVEL=info

# messaging
RABBITMQ_URL=rabbitmq_url

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

#email
ASYNC_MAIL_ENABLED=true
MAIL_PROVIDER=smtp # smtp, sendgrid, aes
MAIL_HOST=mail_host
MAIL_PORT=mail_port
MAIL_SECURE=false
MAIL_USER=mail_user
MAIL_PASS=hello_kitty
MAIL_FROM=mail_from

# Chưa dùng tới
SENDGRID_API_KEY=
AWS_MAIL_ACCESS_KEY_ID=
AWS_MAIL_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1 # 



# --- STORAGE (S3/R2) ---
S3_REGION=auto
S2_TOKEN=hello_kitty
S3_ENDPOINT=s3_endpoint_url # r2 storage url
S3_ACCESS_KEY=s3_access_key
S3_SECRET_KEY=s3_secret_key
S3_BUCKET_NAME=s3_bucket_name
S3_PUBLIC_URL=https://your-custom-domain.com


# gg
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=hello_kitty
GOOGLE_CALLBACK_URL='http://your-domain.com/api/auth/google/callback'


# COUNTRY API KEY
COUNTRY_API_KEY=hello_kitty

# TMDB API KEY
TMDB_API_TOKEN=hello_kitty