# APP_NAME=movie-recommendation-ai-service
# APP_VERSION=0.1.0
# APP_PORT=8082
# API_PREFIX=/api
# CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# SERVICE_NAME=ai-service
# OTEL_ENABLED=false
# OTEL_EXPORTER_URL=http://localhost:4317

# RABBITMQ_ENABLED=false
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# RABBITMQ_EXCHANGE=movie.events
# RABBITMQ_EXCHANGE_TYPE=topic
# RABBITMQ_QUEUE=ai-service.movie-events
# MOVIE_EVENT_ROUTING_KEY=movie.#
# INTERACTION_EVENT_ROUTING_KEY=user.interaction.#

# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
# REDIS_KEY_PREFIX=movie-recommendation:

# VECTOR_DB_ENABLED=false
# VECTOR_DB_PROVIDER=qdrant
# VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_API_KEY=
# VECTOR_COLLECTION=movies
# VECTOR_SIZE=384

# MODEL_TRAIN_ENABLED=false
# MODEL_TRAIN_CRON=0 3 * * 0