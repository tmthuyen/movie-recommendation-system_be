TMDB_API_KEY=hello_kitty
HF_TOKEN=hello_kitty

JWT_SECRET_KEY=hello_kitty
JWT_ALGORITHM=jwt-algorithm


APP_NAME=movie-recommendation-ai-service
APP_VERSION=0.1.0
APP_PORT=8082
API_PREFIX=/api/recommendations
CORS_ORIGINS=http://localhost:3002,http://localhost:5173

# Observability
# Tracing configuration
SERVICE_NAME=ai-service
OTEL_ENABLED=True
OTEL_EXPORTER_URL=http://localhost:4318

# RabbitMQ
RABBITMQ_ENABLED=True
RABBITMQ_URL=rabbitmq://rbmq_user:rbmq_password@localhost:5672

# Redis
REDIS_ENABLED=True
REDIS_URL=redis://localhost:6379

# VECTOR DB
VECTOR_DB_ENABLED=True 
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_COLLECTION=movies
VECTOR_SIZE=384

MODEL_TRAIN_ENABLED=false
MODEL_TRAIN_CRON=0 3 * * 0

# --- STORAGE (S3/R2) ---
S3_REGION=auto
S2_TOKEN=hello_kitty
S3_ENDPOINT=s3_endpoint_url # r2 storage url
S3_ACCESS_KEY=s3_access_key
S3_SECRET_KEY=s3_secret_key
S3_BUCKET_NAME=s3_bucket_name
S3_PUBLIC_URL=https://your-custom-domain.com