{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/**/*.{ts,js}": [
      "npx eslint --fix",
      "npx prettier --write"
    ],
    "frontend/**/*.{ts,js,tsx,jsx}": [
      "npm --prefix frontend run lint:fix --",
      "npm --prefix frontend run prettier --write"
    ]
  }
}